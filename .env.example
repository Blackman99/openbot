# Copy this file to .env for local development. Replace all placeholder secrets outside local use.
OPENBOT_ALLOW_INSECURE_LOCAL_PASSWORD=true
OPENBOT_BIND_ADDRESS=127.0.0.1
OPENBOT_DATABASE_PASSWORD=replace-runtime-me
OPENBOT_SETUP_TOKEN=local-only-openbot-setup-token-change-me
# Generate once with: openssl rand -base64 32. Preserve the key across restarts and backups.
# Empty disables model connections and leaves the Task worker idle without claiming queued Runs.
OPENBOT_PROVIDER_ENCRYPTION_KEY=
OPENBOT_PROVIDER_ALLOWED_HOSTS=api.openai.com
OPENBOT_PROVIDER_ALLOWED_SCHEMES=https
# Non-public destination networks require explicit CIDRs in addition to a listed host.
OPENBOT_PROVIDER_PRIVATE_CIDRS=
POSTGRES_DB=openbot
POSTGRES_USER=openbot
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://openbot:replace-me@localhost:5432/openbot
DATABASE_CONNECTION_TIMEOUT_MS=1000
DATABASE_QUERY_TIMEOUT_MS=1000
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:3001
WEB_HOST=127.0.0.1
WEB_PORT=3000

# Optional OIDC: register WEB_ORIGIN/auth/oidc/callback with the provider.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Avatars: private local volume in Compose; for pnpm dev set an existing absolute writable path.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_PATH=/var/lib/openbot/objects
# S3-compatible alternative: provision a private bucket and a prefix-scoped service identity.
OBJECT_STORAGE_S3_ENDPOINT=
OBJECT_STORAGE_S3_BUCKET=
OBJECT_STORAGE_S3_REGION=us-east-1
OBJECT_STORAGE_S3_ACCESS_KEY_ID=
OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=
OBJECT_STORAGE_S3_SESSION_TOKEN=
# Web adapter limit includes multipart overhead; the API still enforces a 2 MiB image limit.
BODY_SIZE_LIMIT=65M
# Conversation file limit in bytes; maximum 67108864 (64 MiB). Avatar limit stays 2 MiB.
ATTACHMENT_MAX_BYTES=10485760
