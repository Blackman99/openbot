      "BotRemove": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string"
          }
        }
      },
      "RoutingWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedRevision", "defaultGrantId"],
        "properties": {
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "defaultGrantId": {
            "type": ["string", "null"],
            "format": "uuid"
          }
        }
      },
      "RoutingEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["routing"],
        "properties": {
          "routing": {
            "type": "object"
          }
        }
      }
