          "botId": {
            "type": "string",
            "format": "uuid"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "historyAccess": {
            "enum": ["future", "since", "all"]
          },
          "history": {
            "type": "object"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        }
