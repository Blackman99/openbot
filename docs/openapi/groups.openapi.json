  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "ob_<43 base64url characters>"
      }
    },
    "schemas": {
      "InvalidRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": {
                "const": "invalid_group_request"
              }
            }
          }
        }
      },
      "InvalidToken": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": {
                "const": "invalid_api_token"
              }
            }
          }
        }
      },
      "Forbidden": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": {
                "enum": ["insufficient_scope", "group_forbidden"]
              }
            }
          }
        }
      },
      "GroupWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "visibility": {
            "enum": ["private", "workspace"]
          },
          "maxConcurrentRuns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      },
      "GroupPatch": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "visibility": {
            "enum": ["private", "workspace"]
          },
          "maxConcurrentRuns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      },
      "PublicGroup": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "workspaceId",
          "name",
          "description",
          "visibility",
          "role",
          "createdAt",
          "updatedAt",
          "archivedAt",
          "policy",
          "defaultLead"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "visibility": {
            "enum": ["private", "workspace"]
          },
          "role": {
            "enum": ["owner", "admin", "member", null]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "archivedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maxConcurrentRuns"],
            "properties": {
              "maxConcurrentRuns": {
                "type": "integer"
              }
            }
          },
          "defaultLead": {
            "type": ["object", "null"]
          }
        }
      },
