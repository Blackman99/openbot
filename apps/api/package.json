{
  "name": "@openbot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/database/migrate.ts",
    "start": "node dist/server.js",
    "test:integration": "vitest run tests/integration",
    "test:postgres": "vitest run tests/postgres",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "fastify": "5.12.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "pg-mem": "3.0.14",
    "tsx": "4.23.13",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  }
}
